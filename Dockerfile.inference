FROM python:3.11-slim
WORKDIR /app
RUN pip install --no-cache-dir torch==2.7.1 --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir mlflow==2.22.0 pandas==2.2.3 numpy==1.26.4 fastapi==0.115.12 uvicorn==0.34.2
COPY scripts/serve_metropt3.py /app/serve_metropt3.py
ENV MODEL_PATH=/model OMP_NUM_THREADS=4 MKL_NUM_THREADS=4
EXPOSE 8000
CMD ["uvicorn", "serve_metropt3:app", "--host", "0.0.0.0", "--port", "8000"]
